// -*- js -*-
//
// place-diff.mime: add a new diff(from, to) to jp-diffs.mime in correct
// document order, or (without --to) just report where it would go.
//
// upd-epub-to-jp.mime applies the diffs in a single forward find_fuzzy pass
// with an advancing cursor, so we replicate that pass over the base: walk the
// existing diffs in order, advancing the cursor as update() does, and find the
// first existing diff that lies at or after the new diff's place.  The new diff
// goes just before it.  (rfind is exact, so it can't stand in for find_fuzzy's
// matching, hence the forward simulation rather than a reverse search.)
//
//   mime place-diff.mime --from "<base text where it applies>" \
//                        --to "<replacement>" [--base ../4300-h/4300-h.htm] \
//                        [--diffs jp-diffs.mime]

def parseargs() {
    var parser = args_parser();
    parser.string_opt("from", "base (Gutenberg) text where the new diff applies");
    parser.string_opt("to", "replacement text (omit to only report the index)");
    parser.string_opt("base", "base file to search (default ../4300-h/4300-h.htm)");
    parser.string_opt("diffs", "diffs file to edit (default jp-diffs.mime)");
    return parser.parse();
}

// escape a string for use as a chaiscript double-quoted literal
def escape_str(s) {
    var t = buffer();
    t.paste(s);
    t.start_of_buffer(); t.replace("\\", "\\\\");
    t.start_of_buffer(); t.replace("\"", "\\\"");
    return t.get_contents();
}

eval_file("jp-diffs.mime"); // defines `class diff` and `var items`

var args = parseargs();
var basefile = args.base;
if (basefile.empty()) { basefile = "../4300-h/4300-h.htm"; }
var difffile = args.diffs;
if (difffile.empty()) { difffile = "jp-diffs.mime"; }

var b = buffer(basefile, must_open);
b.start_of_buffer();
if (b.find_fuzzy(args.from) < 0) {
    print("place_not_found");
} else {
    // forward simulation to find the insertion index
    b.start_of_buffer();
    var idx = items.size();
    for (var k = 0; k < items.size(); ++k) {
        var at = b.get_pos();
        var new_pos = b.find_fuzzy(args.from);
        b.goto_pos(at);
        var item_pos = b.find_fuzzy(items[k].from);
        if (new_pos >= 0 && new_pos <= item_pos) { idx = k; break; }
        if (item_pos < 0) { b.goto_pos(at); }
    }

    if (args.to.empty()) {
        print("insert_before:" + to_string(idx));
    } else {
        // insert the new diff before item idx in the diffs file
        var block = "diff(\n        \"" + escape_str(args.from) +
                    "\",\n        \"" + escape_str(args.to) + "\"),\n\n    ";
        var df = buffer(difffile, must_open);
        df.start_of_buffer();
        df.goto_pos(df.find("var items = ["));
        if (idx >= items.size()) {
            // append before the closing ] (last item needs a trailing comma)
            df.goto_pos(df.rfind("]"));
            df.rfind(")");
            df.forward(1);
            df.paste(",\n\n    " + "diff(\n        \"" + escape_str(args.from) +
                     "\",\n        \"" + escape_str(args.to) + "\")");
        } else {
            // advance to item idx's "diff(", then back up to its line and insert
            for (var k = 0; k <= idx; ++k) { df.find("diff("); }
            df.rfind("diff(");
            df.paste(block);
        }
        df.save_as(difffile);
        print("inserted_before:" + to_string(idx));
    }
}
