;;; add-anno structure/reorder transforms — ports of the same-named functions in
;;; add-anno.mime, editing the CURRENT buffer. The reorders and the anchor fixer
;;; below have been migrated to plain Emacs primitives; the document-structure
;;; edits (update_*, *_first_page, insert_preface) still use mime-compat pending
;;; migration.

;; Move a passage between two anchor phrases to just after a third.
(defun lotus-reorder ()
  (search-forward "saint Peter Claver and the African Mission.")
  (let ((start (point)))
    (search-forward "religion.")
    (let ((passage (buffer-substring start (point))))
      (delete-region start (point))
      (search-forward "Rank heresy for them. ")
      (insert passage)))
  (goto-char (point-min)))

(defun aeolus-reorder ()
  (search-forward "Hell of a racket they make.")
  (let ((start (point)))
    (search-forward "Iron nerves.")
    (let ((passage (buffer-substring start (point))))
      (delete-region start (point))
      (search-backward "He wants it in for July")
      (search-forward "</p>")
      (insert (concat "<p>" passage "</p>"))))
  (goto-char (point-min)))

(defun penelope-reorder ()
  (search-forward "they hide it with a cabbageleaf")
  (let ((start (point)))
    (search-forward "kick or a bang of something there")
    (let ((passage (buffer-substring start (point))))
      (delete-region start (point))
      (search-forward "go about like that I asked him")
      (insert passage)))
  (goto-char (point-min)))

;; Move each "<a ...>H2 anchor</a>" inside the following </h2>.
(defun fix-chapter-anchors ()
  (goto-char (point-min))
  (while (search-forward "H2 anchor" nil t)
    (search-forward "</a>")
    (let ((end (point)))
      (search-backward "<a")
      (let ((anchor (buffer-substring (point) end)))
        (delete-region (point) end)
        (search-forward "</h2>")
        (insert anchor))))
  (goto-char (point-min)))

;; ---- document-structure edits (CSS, title page, TOC, preface) ---------------

(defun add_epub_namespace ()
  (find "1999/xhtml\"")
  (paste " xmlns:epub=\"http://www.idpf.org/2007/ops\""))

(defun update_css ()
  (find "p {")
  (next_line)
  (paste "p.pagebreak { page-break-after:always; }\n")
  (paste "p.firstpage {text-align: justify; margin-top: 1em; margin-bottom: 1em; text-indent: 0;}\n")
  (paste "p.preface { margin-bottom: 1.3em; }")
  (paste "p.preface-li { text-indent: 0; margin-bottom: 1.3em; }")
  (replace ".toc       { margin-left: 1%"  ".toc       { margin-left: 0")
  (replace ".toc2      { margin-left: 20%" ".toc2      { text-align: left; margin-left: 0"))

;; Replace the Gutenberg <pre> header with the firstpage template (its
;; %lastupdated% filled in with DATE). FILENAME is the template's full path.
(defun replace_first_page (filename date)
  (goto_pos (find "<pre xml:space=\"preserve\">"))
  (set_mark)
  (find "</pre>")
  (erase_region)
  (let ((epub (current-buffer)) (contents nil))
    (find-file filename)
    (start_of_buffer)
    (replace "%lastupdated%" date)
    (setq contents (buffer-string))
    (set-buffer epub)
    (paste contents)
    (paste pagebreak)))

(defun update_author_formatting ()
  (replace "<p class=\"title3\">Ulysses</p>" "<p class=\"title3\"><em>Ulysses</em></p>")
  (let ((author-start (find_fuzzy "<h2> by James Joyce </h2>")))
    (set_mark)
    (goto_pos author-start)
    (erase_region)
    (paste "<h3>by James Joyce</h3>"))
  (find "<hr />")
  (paste pagebreak))

(defun update_toc ()
  (find "<div class=\"toc\">")
  (backward)
  (paste " style=\"text-align: center;\"")
  (forward)
  (paste "<a href=\"#link2H_4_preface\"> Preface </a><br /><br />")
  (let ((ii 1))
    (while (<= ii 18)
      (let* ((iis (to_string ii))
             (st (find_fuzzy (concat "[ " iis " ]"))))
        (set_mark)
        (goto_pos st)
        (erase_region)
        (paste (concat " " iis " [" (nth (1- ii) chapter-names) "] ")))
      (setq ii (1+ ii))))
  (find "</div>")
  (paste "<br /> <div>")
  (paste "<a href=\"#link2H_4_annotations\"> Annotations </a><br />")
  (paste "<a href=\"#link2H_4_index_titles\"> Index of Notes </a><br /></div>")
  (find "<hr />")
  (paste pagebreak))

(defun insert_preface ()
  (find "<a name=\"link2H_4_0001\" id=\"link2H_4_0001\">")
  (rfind "<p>")
  (let ((epub (current-buffer)) (contents nil))
    (find-file (concat templates-path "preface.htm"))
    (setq contents (buffer-string))
    (set-buffer epub)
    (paste contents)
    (paste pagebreak)))
