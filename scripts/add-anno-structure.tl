;;; add-anno structure/reorder transforms — ports of the same-named functions in
;;; add-anno.mime, editing the CURRENT buffer. The reorders and the anchor fixer
;;; below have been migrated to plain Emacs primitives; the document-structure
;;; edits (update_*, *_first_page, insert_preface) still use mime-compat pending
;;; migration.

;; Move a passage between two anchor phrases to just after a third.
(defun lotus-reorder ()
  (search-forward "saint Peter Claver and the African Mission.")
  (let ((start (point)))
    (search-forward "religion.")
    (let ((passage (buffer-substring start (point))))
      (delete-region start (point))
      (search-forward "Rank heresy for them. ")
      (insert passage)))
  (goto-char (point-min)))

(defun aeolus-reorder ()
  (search-forward "Hell of a racket they make.")
  (let ((start (point)))
    (search-forward "Iron nerves.")
    (let ((passage (buffer-substring start (point))))
      (delete-region start (point))
      (search-backward "He wants it in for July")
      (search-forward "</p>")
      (insert (concat "<p>" passage "</p>"))))
  (goto-char (point-min)))

(defun penelope-reorder ()
  (search-forward "they hide it with a cabbageleaf")
  (let ((start (point)))
    (search-forward "kick or a bang of something there")
    (let ((passage (buffer-substring start (point))))
      (delete-region start (point))
      (search-forward "go about like that I asked him")
      (insert passage)))
  (goto-char (point-min)))

;; Move each "<a ...>H2 anchor</a>" inside the following </h2>.
(defun fix-chapter-anchors ()
  (goto-char (point-min))
  (while (search-forward "H2 anchor" nil t)
    (search-forward "</a>")
    (let ((end (point)))
      (search-backward "<a")
      (let ((anchor (buffer-substring (point) end)))
        (delete-region (point) end)
        (search-forward "</h2>")
        (insert anchor))))
  (goto-char (point-min)))

;; ---- document-structure edits (CSS, title page, TOC, preface) ---------------

(defun add-epub-namespace ()
  (search-forward "1999/xhtml\"")
  (insert " xmlns:epub=\"http://www.idpf.org/2007/ops\""))

(defun update-css ()
  (search-forward "p {")
  (forward-line 1)
  (insert "p.pagebreak { page-break-after:always; }\n")
  (insert "p.firstpage {text-align: justify; margin-top: 1em; margin-bottom: 1em; text-indent: 0;}\n")
  (insert "p.preface { margin-bottom: 1.3em; }")
  (insert "p.preface-li { text-indent: 0; margin-bottom: 1.3em; }")
  (replace-string ".toc       { margin-left: 1%"  ".toc       { margin-left: 0")
  (replace-string ".toc2      { margin-left: 20%" ".toc2      { text-align: left; margin-left: 0"))

;; Replace the Gutenberg <pre> header with the firstpage template (its
;; %lastupdated% filled in with DATE). FILENAME is the template's full path.
(defun replace-first-page (filename date)
  (search-forward "<pre xml:space=\"preserve\">")
  (let ((start (match-beginning 0)))
    (search-forward "</pre>")
    (delete-region start (point))
    (insert (with-current-buffer (find-file-noselect filename)
              (goto-char (point-min))
              (replace-string "%lastupdated%" date)
              (buffer-string)))
    (insert pagebreak)))

(defun update-author-formatting ()
  (replace-string "<p class=\"title3\">Ulysses</p>" "<p class=\"title3\"><em>Ulysses</em></p>")
  (let* ((start (find_fuzzy "<h2> by James Joyce </h2>"))
         (end (point)))
    (delete-region start end)
    (goto-char start)
    (insert "<h3>by James Joyce</h3>"))
  (search-forward "<hr />")
  (insert pagebreak))

(defun update-toc ()
  (search-forward "<div class=\"toc\">")
  (backward-char)
  (insert " style=\"text-align: center;\"")
  (forward-char)
  (insert "<a href=\"#link2H_4_preface\"> Preface </a><br /><br />")
  (let ((ii 1))
    (while (<= ii 18)
      (let* ((iis (number-to-string ii))
             (start (find_fuzzy (concat "[ " iis " ]")))
             (end (point)))
        (delete-region start end)
        (goto-char start)
        (insert (concat " " iis " [" (nth (1- ii) chapter-names) "] ")))
      (setq ii (1+ ii))))
  (search-forward "</div>")
  (insert "<br /> <div>")
  (insert "<a href=\"#link2H_4_annotations\"> Annotations </a><br />")
  (insert "<a href=\"#link2H_4_index_titles\"> Index of Notes </a><br /></div>")
  (search-forward "<hr />")
  (insert pagebreak))

(defun insert-preface ()
  (search-forward "<a name=\"link2H_4_0001\" id=\"link2H_4_0001\">")
  (search-backward "<p>")
  (insert (with-current-buffer (find-file-noselect (concat templates-path "preface.htm"))
            (buffer-string)))
  (insert pagebreak))
