// -*- js -*-

def parseargs() {
    var parser = args_parser();
    parser.string_opt("infile", "path of the input file");
    parser.string_opt("outfile", "path of the output file");
    return parser.parse();
}

def update(b, from, to) {
    var start = b.find_fuzzy(from);
    if(start == -1) {
	print("failed: " + from);
	return false;
    }
    var end = b.get_pos();

    var ex_start = start - 20;
    var ex_end = end + 20;

    b.goto_pos(ex_start);
    b.set_mark();
    b.goto_pos(ex_end);
    var from_r = b.copy();

    b.goto_pos(start);
    b.set_mark();
    b.goto_pos(end);
    b.erase_region();
    b.paste(to);

    b.forward(20);
    b.set_mark();
    b.goto_pos(ex_start);
    var to_r = b.copy();

    // print("Text: " + from +
    // 	  "\nFrom_text:\n" + from_r +
    // 	  "\nTo_text:\n" + to_r +
    // 	  "\n--------------------\n");
    return true;
}

eval_file("jp-diffs.mime");



var args = parseargs();

var epub = buffer(args.infile, must_open);

var success = true;
for(i : items) {
    if (!update(epub, i.from, i.to)) {
	success = false;
    }
}

if(success) {
    epub.save_as(args.outfile);
}
